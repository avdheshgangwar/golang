# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=qr_collection
DB_SSLMODE=disable

# Application Configuration
APP_PORT=8080
APP_ENV=development
LOG_LEVEL=info

# Security
JWT_SECRET=your_jwt_secret_here
API_KEY_SECRET=your_api_key_secret_here

# QR Code Configuration
QR_DEFAULT_SIZE=256
QR_DEFAULT_FORMAT=png
QR_STORAGE_PATH=./storage/qr_codes

# Bank Integration (if needed)
BANK_API_TIMEOUT=30s
BANK_WEBHOOK_SECRET=your_webhook_secret_here